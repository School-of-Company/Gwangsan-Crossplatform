{
  "cli": {
    "version": ">= 16.13.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NODE_ENV": "development"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "environment": "preview",
      "env": {
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "apk",
        "env": {
          "SENTRY_ALLOW_FAILURE": "true"
        }
      }
    },
    "preview2": {
      "environment": "preview",
      "env": {
        "NODE_ENV": "production"
      },
      "android": {
        "gradleCommand": ":app:assembleRelease",
        "env": {
          "SENTRY_ALLOW_FAILURE": "true"
        }
      }
    },
    "preview3": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NODE_ENV": "development"
      },
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "NODE_ENV": "production"
      },
      "ios": {
        "autoIncrement": true,
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "android": {
        "autoIncrement": true,
        "env": {
          "SENTRY_ALLOW_FAILURE": "true"
        }
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6758655368",
        "appleTeamId": "UB2797YAAH"
      },
      "android": {
        "serviceAccountKeyPath": "./service_account.json",
        "track": "production"
      }
    }
  }
}
